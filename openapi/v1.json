  "components": {
    "schemas": {
      "AdminImage": {
        "required": [
          "id",
          "url",
          "altText",
          "isPrimary",
          "sortOrder",
          "contentType",
          "sizeBytes",
          "width",
          "height",
          "originalFileName",
          "createdAtUtc",
          "createdBy"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "url": {
            "type": "string"
          },
          "altText": {
            "type": [
              "null",
              "string"
            ]
          },
          "isPrimary": {
            "type": "boolean"
          },
          "sortOrder": {
            "type": "integer",
            "format": "int32"
          },
          "contentType": {
            "type": "string"
          },
          "sizeBytes": {
            "type": "integer",
            "format": "int32"
          },
          "width": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "height": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "originalFileName": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AdminMe": {
        "required": [
          "id",
          "email",
          "displayName",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AvailabilityStatus": {
        "enum": [
          "OutOfStock",
          "LowStock",
          "InStock"
        ]
      },
      "BannerDto": {
        "required": [
          "title",
          "subtitle",
          "imageUrl",
          "altText",
          "linkUrl"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageUrl": {
            "type": "string"
          },
          "altText": {
            "type": "string"
          },
          "linkUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "BrandDetail": {
        "required": [
          "slug",
          "name",
          "description",
          "logoUrl",
          "productCount"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "productCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "BrandRef": {
        "required": [
          "slug",
          "name"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "BrandSummary": {
        "required": [
          "slug",
          "name",
          "logoUrl",
          "productCount"
        ],
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "logoUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "productCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CatalogFilters": {
        "required": [
          "brands",
          "categories",
          "concentrations",
          "volumesMl",
          "priceRange",
          "sortOptions"
        ],
        "type": "object",
        "properties": {
          "brands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BrandRef"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CategoryRef"
            }
          },
          "concentrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConcentrationRef"
            }
          },
          "volumesMl": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            }
